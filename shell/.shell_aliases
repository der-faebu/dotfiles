# Debian-specific

if [[ $( grep -i '^ID=' /etc/os-release | sed 's/ID=//') == 'debian' ]]; then
	echo 'Debian here. Applying Debian-sepecific aliases'
  apt() {
    command nala "$@"
  }
  sudo() {
    if [ "$1" = "apt" ]; then
      shift
      command sudo nala "$@"
    else
      command sudo "$@"
    fi
  }
fi

